
#include <iostream>
using namespace std;

class InvalidMarks {
public:
    void display() {
        cout << "Exception: Marks must be between 0 and 100.";
    }
};

int main() {
    int n, marks, total = 0;
    float average;

    cin >> n;

    try {
        for (int i = 0; i < n; i++) {
            cin >> marks;

            if (marks < 0 || marks > 100)
                throw InvalidMarks();

            total += marks;
        }

        average = (float)total / n;

        cout << "Total = " << total << endl;
        cout << "Average = " << average << endl;

        if (average >= 80)
            cout << "Grade = A";
        else if (average >= 60)
            cout << "Grade = B";
        else if (average >= 40)
            cout << "Grade = C";
        else
            cout << "Grade = F";
    }
    catch (InvalidMarks e) {
        e.display();
    }

    return 0;
}
